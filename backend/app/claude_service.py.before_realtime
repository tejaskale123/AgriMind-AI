from pathlib import Path
import json
import os

from dotenv import load_dotenv
from anthropic import Anthropic


# ============================================================
# PATH CONFIGURATION
# ============================================================

PROJECT_ROOT = Path(__file__).resolve().parents[2]

ENV_PATH = PROJECT_ROOT / ".env"

RECOMMENDATIONS_PATH = (
    PROJECT_ROOT
    / "backend"
    / "data"
    / "disease_recommendations.json"
)


# ============================================================
# ENVIRONMENT
# ============================================================

load_dotenv(ENV_PATH)

ANTHROPIC_API_KEY = os.getenv("ANTHROPIC_API_KEY")

# IMPORTANT:
# We are intentionally using Claude Sonnet 4.5.
CLAUDE_MODEL = "claude-sonnet-4-5-20250929"


# ============================================================
# CLAUDE CLIENT
# ============================================================

def get_claude_client():
    """
    Create and return the Anthropic client.

    The API key is loaded from the project's .env file.
    """

    if not ANTHROPIC_API_KEY:
        raise RuntimeError(
            "ANTHROPIC_API_KEY was not found in .env"
        )

    return Anthropic(
        api_key=ANTHROPIC_API_KEY
    )


# ============================================================
# VERIFIED RECOMMENDATION DATA
# ============================================================

def load_recommendations():
    """
    Load the source-backed disease recommendation database.
    """

    if not RECOMMENDATIONS_PATH.exists():
        raise FileNotFoundError(
            f"Recommendation file not found: "
            f"{RECOMMENDATIONS_PATH}"
        )

    with open(
        RECOMMENDATIONS_PATH,
        "r",
        encoding="utf-8"
    ) as file:
        return json.load(file)


def get_verified_recommendation(disease: str):
    """
    Find the verified recommendation for the predicted disease.

    Returns None if the disease is not present.
    """

    recommendations = load_recommendations()

    # Direct match
    if disease in recommendations:
        return recommendations[disease]

    # Case-insensitive match
    disease_lower = disease.strip().lower()

    for name, recommendation in recommendations.items():
        if name.strip().lower() == disease_lower:
            return recommendation

    return None


# ============================================================
# CLAUDE RECOMMENDATION GENERATION
# ============================================================

def generate_claude_recommendation(
    crop: str,
    disease: str,
    confidence: float | None = None,
):
    """
    Generate structured Plant Care & Management information
    using Claude Sonnet 4.5.

    Claude receives verified source-backed information from
    disease_recommendations.json.

    Claude must NOT invent pesticides, doses, or spray schedules.
    """

    verified_recommendation = get_verified_recommendation(
        disease
    )

    # --------------------------------------------------------
    # SAFETY FALLBACK
    # --------------------------------------------------------

    if not verified_recommendation:
        return {
            "severity": "Unknown",
            "symptoms": (
                "Verified recommendation information "
                "is not available for this condition."
            ),
            "immediate_action": (
                "Inspect the affected plant carefully and "
                "consult a qualified local agriculture expert."
            ),
            "prevention": (
                "Follow locally recommended crop-management "
                "and sanitation practices."
            ),
            "spray_guidance": (
                "Do not apply a chemical spray based only on "
                "the AI prediction. Follow the current "
                "registered local label or agricultural advisory."
            ),
            "treatment": (
                "No verified treatment information is available "
                "in the AgriMind AI knowledge base."
            ),
            "farmer_action": (
                "Monitor the crop and seek local agricultural "
                "guidance if symptoms continue or spread."
            ),
            "source": (
                "AgriMind AI verified recommendation database"
            ),
        }

    # --------------------------------------------------------
    # VERIFIED CONTEXT
    # --------------------------------------------------------

    verified_context = json.dumps(
        verified_recommendation,
        ensure_ascii=False,
        indent=2
    )

    confidence_text = (
        f"{confidence:.2f}%"
        if confidence is not None
        else "Not provided"
    )

    # --------------------------------------------------------
    # SYSTEM / USER INSTRUCTIONS
    # --------------------------------------------------------

    prompt = f"""
You are the agricultural management assistant for AgriMind AI.

The machine-learning model has already predicted the disease.
DO NOT change or re-classify the disease.

Crop:
{crop}

Predicted condition:
{disease}

Model confidence:
{confidence_text}

Your task is to convert the VERIFIED agricultural information
below into clear, practical farmer-facing management guidance.

IMPORTANT SAFETY RULES:

1. Use ONLY the verified information provided below.
2. Do NOT invent agricultural facts.
3. Do NOT invent pesticides, fungicides, bactericides,
   biological products, dosages, concentrations, intervals,
   spray schedules, or application methods.
4. If the verified information does not provide a chemical
   recommendation, clearly say that no specific chemical spray
   recommendation is provided.
5. Prefer organic, biological, cultural, sanitation,
   canopy-management and sustainable practices when supported
   by the verified information.
6. Do not claim that the AI prediction is 100% certain.
7. Keep the advice practical and understandable for farmers.
8. Preserve important source/label/local-guidance limitations.
9. The source field must identify the source supplied in the
   verified information.
10. Do not add a new source that is not present in the
    verified information.

Return ONLY the requested JSON structure.

VERIFIED AGRICULTURAL INFORMATION:

{verified_context}
"""

    # --------------------------------------------------------
    # JSON SCHEMA
    # --------------------------------------------------------

    recommendation_schema = {
        "type": "object",
        "properties": {
            "severity": {
                "type": "string"
            },
            "symptoms": {
                "type": "string"
            },
            "immediate_action": {
                "type": "string"
            },
            "prevention": {
                "type": "string"
            },
            "spray_guidance": {
                "type": "string"
            },
            "treatment": {
                "type": "string"
            },
            "farmer_action": {
                "type": "string"
            },
            "source": {
                "type": "string"
            }
        },
        "required": [
            "severity",
            "symptoms",
            "immediate_action",
            "prevention",
            "spray_guidance",
            "treatment",
            "farmer_action",
            "source"
        ],
        "additionalProperties": False
    }

    # --------------------------------------------------------
    # CALL CLAUDE SONNET 4.5
    # --------------------------------------------------------

    try:
        client = get_claude_client()

        response = client.messages.create(
            model=CLAUDE_MODEL,
            max_tokens=1200,
            messages=[
                {
                    "role": "user",
                    "content": prompt
                }
            ],
            output_config={
                "format": {
                    "type": "json_schema",
                    "schema": recommendation_schema
                }
            }
        )

        # Find the text response block
        response_text = None

        for block in response.content:
            if block.type == "text":
                response_text = block.text
                break

        if not response_text:
            raise RuntimeError(
                "Claude returned an empty response."
            )

        return json.loads(response_text)

    # --------------------------------------------------------
    # SAFE FALLBACK
    # --------------------------------------------------------

    except Exception as error:
        print(
            f"WARNING: Claude recommendation generation failed: "
            f"{error}"
        )

        # If Claude fails, return the verified recommendation
        # rather than inventing new information.
        return verified_recommendation